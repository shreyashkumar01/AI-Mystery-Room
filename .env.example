# Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank to automatically use zero-config embedded in-memory MongoDB)
MONGODB_URI=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Optional Media Provider
MEDIA_PROVIDER=
MEDIA_API_KEY=
